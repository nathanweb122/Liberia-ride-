rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // GATES & BASE PRIMITIVES
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Type validators and size limits for Drivers & Riders
    function isValidDriver(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && (!('role' in data) || (data.role is string && (data.role == 'Chauffeur' || data.role == 'Rider' || data.role == 'Kekeh' || data.role == 'Client' || data.role == 'Admin')))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50));
    }

    // Type validators and size limits for Payments
    function isValidPayment(data) {
      return data.id is string && data.id.size() <= 128
        && data.driverId is string && data.driverId.size() <= 128
        && data.amount is number
        && data.referenceCode is string && data.referenceCode.size() <= 100
        && data.payerPhone is string && data.payerPhone.size() <= 50
        && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    // Type validators and size limits for ActiveTrip
    function isValidActiveTrip(data) {
      return data.status is string && (data.status == 'ready' || data.status == 'transit' || data.status == 'completed')
        && data.isActive is bool
        && data.elapsedTime is number
        && (!('pickup' in data) || (data.pickup is string && data.pickup.size() <= 500))
        && (!('destination' in data) || (data.destination is string && data.destination.size() <= 500))
        && (!('passengers' in data) || data.passengers is list)
        && (!('amenities' in data) || data.amenities is list)
        && (!('sosActive' in data) || data.sosActive is bool);
    }

    // 2. Drivers and Riders collection matching
    match /drivers/{driverId} {
      allow read: if true;

      allow create, update: if (
        // Case 1: Active Trip shared document
        (driverId == 'active_trip' && isValidActiveTrip(incoming())) ||
        // Case 2: Standard Driver or Rider profile document
        (driverId != 'active_trip' && (
          (isSignedIn() && (request.auth.uid == driverId || isValidDriver(incoming()))) ||
          (!isSignedIn() && isValidDriver(incoming()))
        ))
      );

      allow delete: if true;
    }

    // 3. Payment submissions compliance sheet mirroring
    match /payments/{paymentId} {
      allow read: if true;

      allow create, update: if (
        isValidId(paymentId) && isValidPayment(incoming())
      );

      allow delete: if true;
    }

    // 4. Test connection probe
    match /test/{testId} {
      allow read: if true;
    }
  }
}
